# Offline reviewed-demo replay is the default and needs no credentials.
POLICYIMPACT_AGENT_MODE=offline

# Optional live role calls. Never commit the real key.
# POLICYIMPACT_AGENT_MODE=live
# OPENAI_API_KEY=
# Current balanced default for this small structured-output workflow.
# Override explicitly if your OpenAI account uses a different supported model.
# POLICYIMPACT_MODEL=gpt-5.6-terra
